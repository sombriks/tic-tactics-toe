---
layout: layouts/default.pug
title: Tic-Tactics-Toe
---
table 
  tr
    td(colspan="3")
      h1 #{title}
  tr
    td(rowspan="3")
      .col-rev
        each c in cards.deck
          pre.square.in-deck.attacker.
            #{c.type}
            A: #{cards.types[c.type].attack}
            D: #{cards.types[c.type].defense}
    td
    td(rowspan="3") 
      .col
        .square
        .square
        .square
  tr
    td 
      .col
        - for (let i = 0 ; i < 3 ; i++)
          .row
            - for (let j = 0 ; j < 3 ; j++)
              - let c = cards.board[j]
              pre.square.in-board.defender.
                #{c.type}
                A: #{cards.types[c.type].attack}
                D: #{cards.types[c.type].defense}

  tr
    td CP: 10/15