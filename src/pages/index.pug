---
layout: layouts/default.pug
title: Tic-Tactics-Toe
---
include ../includes/components/card.pug
table
  - let boardCP = {a:0,d:0}
  tr
    td(colspan="3")
      h1 #{title}
  tr
    td(rowspan="3")
      .col-rev
        each c,i in cards.deck
         +card(c).in-deck.attacker(data-index=i)
    td
    td(rowspan="3")
      .col#event-log
  tr
    td
      table
        - for (let i = 0 ; i < 3 ; i++)
          tr
            - for (let j = 0 ; j < 3 ; j++)
              td
                .square
                  - let c = cards.board[j+3*i]
                  +card(c).in-board.defender(data-index=(j+3*i) onclick="attack(this)")
                  - boardCP.a += cards.types[c.type].attack
                  - boardCP.d += cards.types[c.type].defense
  tr
    td#status-line CP: #{boardCP.a}/#{boardCP.d}
