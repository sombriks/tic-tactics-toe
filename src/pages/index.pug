---
layout: layouts/default.pug
title: Tic-Tactics-Toe
---
include ../includes/components/card.pug
table
  tr
    td(colspan="4")
      h1 Challenge #1234
  tr
    td(rowspan="6")
      .col-rev#deck(x-data="{cards: $store.deck.cards}")
        template(x-for="(card, i) in cards")
          +card().in-deck.attacker(data-index="i")
    td
    td(rowspan="6")
      .col#event-log
  tr
    td
      table#board(x-data="{cards: $store.board.cards}")
        template(x-for="i in [0,1,2]")
          tr
            template(x-for="j in [0,1,2]")
              td
                .square.terrain(x-data="{card: cards[j+3*i]}")
                  +card().in-board.defender(:data-index="j+3*i" onclick="attack(this)")
  tr#share.hide(colspan="3")
    td
      button(onclick="share('https://bsky.app/intent/compose')") Bluesky
      button(onclick="share('https://mastodon.world/share')") Mastodon
      button(onclick="share('https://www.threads.net/intent/post')") Threads
      button(onclick="buildMessage()") Clipboard
