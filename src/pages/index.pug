---
layout: layouts/default.pug
title: Tic-Tactics-Toe
---
include ../includes/components/card.pug
table
  - let boardCP = {a:0,d:0}
  tr
    td(colspan="3")
      h1 #{title}
  tr
    td(rowspan="3")
      .col-rev
        each c in cards.deck
         +card(c).in-deck.attacker
    td
    td(rowspan="3")
      .col
        .square
        .square
        .square
  tr
    td
      .col
        - for (let i = 0 ; i < 3 ; i++)
          .row
            - for (let j = 0 ; j < 3 ; j++)
              - let c = cards.board[j+3*i]
              +card(c).in-board.defender(onclick="attack(this)")
              - boardCP.a += cards.types[c.type].attack
              - boardCP.d += cards.types[c.type].defense
  tr
    td CP: #{boardCP.a}/#{boardCP.d}
