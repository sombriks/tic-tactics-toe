doctype html
html
    head
        title Tic Tactics Toe
        meta(name="viewport" content="width=device-width,initial-scale=1.0,minimum-scale=0.5,maximum-scale=2.0")
        script(type="text/javascript" src="/webjars/htmx.org/2.0.2/dist/htmx.js")
        script(type="text/javascript" src="/webjars/alpinejs/3.14.3/dist/cdn.js" defer)
        script(type="text/javascript" src="/main-layout.js" defer)
        link(rel="stylesheet" href="/main-layout.css")
    body
        .content(x-data="{deck:[]}")
            .deck
              each v in [1,2,3,4,5,6,7,8,9]
                  .card.attacker(
                      data-cp="4",
                      data-card-id="123"
                      data-deck-id="123"
                      data-status="ready"
                      x-init="deck.push($el)")
                      div= v
            .board
              each v in [1,2,3,4,5,6,7,8,9]
                  .card.defender(
                      data-cp="4",
                      data-card-id="123"
                      data-board-id="123"
                      data-status="face-down"
                      @click="$store.ttt.attack($el, deck)")
                      div ?
