mixin card()
    .card.square(
        :data-attack="card.attack"
        :data-defense="card.defense"
        :data-status="card.status"
        :data-code="card.code"
        :class="card.status"
        data-fights="0")&attributes(attributes)
        template(x-if="card.status == 'ready'")
            pre(x-text="`${card.code}\nA: ${card.attack}\nD: ${card.defense}`")
        template(x-if="card.status == 'face-down'")
            pre(x-text="'???'")
