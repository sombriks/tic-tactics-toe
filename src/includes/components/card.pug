mixin card()
    .card.square(x-if="card"
        :data-attack="card.attack"
        :data-defense="card.defense"
        :data-status="card.status"
        :data-code="card.code"
        :class="card.status"
        data-fights="0")&attributes(attributes)
        pre.square(
            x-if="card.status == 'ready'"
            x-text="`${card.code}\nA: ${card.attack}\nD: ${card.defense}`")
        pre.square(
            x-if="card.status == 'face-down'" 
            x-text="'???'")
