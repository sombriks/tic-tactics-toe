include ./card.pug
mixin board(id)
  table.board 
    thead
      tr
        th CP: 34/23 W: 2 L: 1 D:0
        th= `Challenge #${id}`
    tbody
      tr 
        td(colspan="2")
          - for(let i = 0; i < 3; i++)
            .grid
              - for(let j = 0; j < 3; j++)
                +card(i+j)
        
  